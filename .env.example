# Copiază în .env.local și completează. Fișierul .env.local NU se comite.

# --- Baza de date (Neon) ---
# Connection string pooled, pentru runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/liro?sslmode=require"
# Connection string direct (non-pooled), pentru migrări și teste de integrare
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/liro?sslmode=require"

# --- Auth.js v5 ---
# Generează cu: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Magic link prin email (Resend sau alt provider SMTP)
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="noreply@example.com"

# --- Anthropic (doar server-side; nu prefixa cu NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=""
# Buget lunar de siguranță pentru apelurile AI, în USD
AI_MONTHLY_BUDGET_USD="50"

# --- Storage audio (Cloudflare R2, API S3-compatibil) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="liro-media"
R2_PUBLIC_BASE_URL=""

# --- Aplicație ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Pragul de reprogramare, în ore (brief §5)
RESCHEDULE_MIN_HOURS="24"
